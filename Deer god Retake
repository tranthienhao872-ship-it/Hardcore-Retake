function System:GetGitSound(
    url,
    name
)

    if not (
        writefile
        and isfile
        and game.HttpGet
        and (
            getcustomasset
            or getsynasset
        )
    ) then

        return nil

    end

    local filename =
        name .. ".mp3"

    if not isfile(filename) then

        local success,
            content =
            pcall(function()

                return game:HttpGet(
                    url
                )

            end)

        if not success
            or not content then

            return nil

        end

        writefile(
            filename,
            content
        )

    end

    local getasset =
        getcustomasset
        or getsynasset

    local success,
        asset =
        pcall(function()

            return getasset(
                filename
            )

        end)

    if not success
        or not asset then

        return nil

    end

    local sound =
        Instance.new("Sound")

    sound.SoundId =
        asset

    return sound

end

--========================================================--
-- ROOM DETECTION
--========================================================--

function System:GetRoomNumber(room)

    if not room then
        return nil
    end

    return tonumber(
        room.Name
    )

end

function System:GetRoomFromPosition(
    position
)

    local nearestRoom =
        nil

    local nearestDistance =
        math.huge

    for _, room in ipairs(
        currentRooms:GetChildren()
    ) do

        if room:IsA("Model") then

            local success,
                roomCF =
                pcall(function()

                    local cf =
                        room:GetBoundingBox()

                    return cf

                end)

            if success
                and roomCF then

                local distance =
                    (
                        roomCF.Position
                        - position
                    ).Magnitude

                if distance <
                    nearestDistance then

                    nearestDistance =
                        distance

                    nearestRoom =
                        room

                end

            end

        end

    end

    return nearestRoom

end

