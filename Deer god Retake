                targetPos
                - currentPos

            local distance =
                difference.Magnitude

            if distance > 0.5 then

                local direction =
                    difference.Unit

                local newPos =
                    currentPos
                    + direction
                    * Config.DeerGodSpeed
                    * dt

                local lookTarget =
                    Vector3.new(
                        targetPos.X,
                        newPos.Y,
                        targetPos.Z
                    )

                if (
                    lookTarget
                    - newPos
                ).Magnitude > 0.001 then

                    deergod:PivotTo(

                        CFrame.lookAt(
                            newPos,
                            lookTarget
                        )

                    )

                end

            end

        end

