--========================================================--
--          DOORS 3% RANDOM SCRIPT 67 SYSTEM             --
--                    DELTA EXECUTOR                     --
--========================================================--

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local CurrentRooms = Workspace:WaitForChild("CurrentRooms")

--========================================================--
-- SETTINGS
--========================================================--

local CHANCE = 3

local SCRIPT_67_URL =
    "https://raw.githubusercontent.com/tranthienhao872-ship-it/Blaa/refs/heads/main/67"

--========================================================--
-- STATE
--========================================================--

local RoomState = {}
local LastRoomNumber = nil
local Initialized = false

--========================================================--
-- RANDOM SEED
--========================================================--

math.randomseed(
    os.time()
        + math.floor(os.clock() * 1000000)
        + math.random(1, 999999)
)

for i = 1, 10 do
    math.random()
end

--========================================================--
-- GET ROOM NUMBER
--========================================================--

local function GetRoomNumber(Room)
    if not Room then
        return nil
    end

    return tonumber(Room.Name)
end

--========================================================--
-- GET CURRENT/LATEST ROOM
--========================================================--

local function GetLatestRoomNumber()

    local Highest = -1

    for _, Room in ipairs(CurrentRooms:GetChildren()) do

        local Number = GetRoomNumber(Room)

        if Number and Number > Highest then
            Highest = Number
        end

    end

    if Highest == -1 then
        return nil
    end

    return Highest
end

--========================================================--
-- SCRIPT 67 LOADER
--========================================================--

local function LoadScript67(RoomNumber)

    if RoomState[RoomNumber] == "HIT" then
        return
    end

    RoomState[RoomNumber] = "HIT"

    print("----------------------------------------")
    print("[3% RANDOM] 🎯 HIT!")
    print("[3% RANDOM] Room:", RoomNumber)
    print("[3% RANDOM] Loading Script 67...")
    print("----------------------------------------")

    task.spawn(function()

        local Success, ErrorMessage = pcall(function()

            -- GET SCRIPT 67
            local Source = game:HttpGet(SCRIPT_67_URL)

            if not Source or Source == "" then
                error("Script 67 trả về rỗng.")
            end

            -- COMPILE SCRIPT 67
            local ScriptFunction, CompileError =
                loadstring(Source)

            if not ScriptFunction then
                error(
                    "Không compile được Script 67: "
                    .. tostring(CompileError)
                )
            end

            -- EXECUTE SCRIPT 67
            ScriptFunction()

        end)

        if Success then

            print(
                "[3% RANDOM] ✅ Script 67 đã kích hoạt ở Room",
                RoomNumber
            )

        else

            warn(
                "[3% RANDOM] ❌ Script 67 lỗi ở Room",
                RoomNumber,
                ":",
                ErrorMessage
            )

            -- Cho phép thử lại ở chính phòng đó
            -- nếu lần load bị lỗi mạng/code.
            RoomState[RoomNumber] = "ERROR"

        end

    end)
end

--========================================================--
-- RANDOM ROOM
--========================================================--

local function RandomizeRoom(RoomNumber)

    if not RoomNumber then
        return
    end

    -- Phòng này đã được xử lý
    if RoomState[RoomNumber] then
        return
    end

    -- Đánh dấu MISS trước khi roll
    -- để event khác không roll trùng.
    RoomState[RoomNumber] = "MISS"

    local Roll = math.random(1, 100)

    print(
        "[3% RANDOM] Room",
        RoomNumber,
        "| Roll:",
        Roll,
        "| Chance:",
        CHANCE .. "%"
    )

    if Roll <= CHANCE then

        LoadScript67(RoomNumber)

    else

        print(
            "[3% RANDOM] ❌ MISS - Room",
            RoomNumber
        )

    end
end

--========================================================--
-- INITIAL ROOM
--========================================================--

local InitialRoom = GetLatestRoomNumber()

if InitialRoom then

    LastRoomNumber = InitialRoom

    -- QUAN TRỌNG:
    -- Không random phòng lúc execute.
    RoomState[InitialRoom] = "INITIAL"

    print(
        "[3% RANDOM] Initial Room:",
        InitialRoom
    )

    print(
        "[3% RANDOM] Initial random: OFF"
    )

else

    LastRoomNumber = -1

end

Initialized = true

--========================================================--
-- CHILD ADDED
--========================================================--

CurrentRooms.ChildAdded:Connect(function(Room)

    if not Initialized then
        return
    end

    local RoomNumber = GetRoomNumber(Room)

    if not RoomNumber then
        return
    end

    task.wait(0.2)

    if RoomNumber > (LastRoomNumber or -1) then

        LastRoomNumber = RoomNumber

        RandomizeRoom(RoomNumber)

    end

end)

--========================================================--
-- BACKUP ROOM DETECTOR
--========================================================--
-- Nếu ChildAdded không bắt được thì watcher này
-- vẫn phát hiện phòng mới.
--
-- RoomState đảm bảo không random trùng.

task.spawn(function()

    while true do

        task.wait(0.35)

        if not Initialized then
            continue
        end

        local LatestRoom = GetLatestRoomNumber()

        if LatestRoom
            and LatestRoom > (LastRoomNumber or -1) then

            LastRoomNumber = LatestRoom

            RandomizeRoom(LatestRoom)

        end

    end

end)

--========================================================--
-- START MESSAGE
--========================================================--

print("")
print("==============================================")
print("       DOORS 3% RANDOM SCRIPT 67")
print("==============================================")
print("Chance per room : 3%")
print("Initial trigger : OFF")
print("Room random     : ON")
print("Duplicate roll  : BLOCKED")
print("Script 67        : CONNECTED")
print("==============================================")
print("")
