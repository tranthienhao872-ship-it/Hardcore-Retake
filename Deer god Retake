function System:Ending()

    local endingGui =
        Instance.new("ScreenGui")

    endingGui.Name =
        "DeerGodEndingFade"

    endingGui.IgnoreGuiInset =
        true

    endingGui.ResetOnSpawn =
        false

    endingGui.DisplayOrder =
        2147483647

    endingGui.Parent =
        playerGui

    local black =
        Instance.new("Frame")

    black.Size =
        UDim2.fromScale(
            1,
            1
        )

    black.Position =
        UDim2.fromScale(
            0,
            0
        )

    black.BackgroundColor3 =
        Color3.new(
            0,
            0,
            0
        )

    black.BackgroundTransparency =
        1

    black.BorderSizePixel =
        0

    black.ZIndex =
        999999

    black.Parent =
        endingGui

    local fadeIn =
        TweenService:Create(

            black,

            TweenInfo.new(
                Config.EndingFadeTime,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.InOut
            ),

            {
                BackgroundTransparency =
                    Config.EndingDarkness
            }

        )

    fadeIn:Play()
    fadeIn.Completed:Wait()

    if not self.Active then
        endingGui:Destroy()
        return
    end

    local sound =
        Instance.new("Sound")

    sound.Name =
        "DeerGodEndingSound"

    sound.SoundId =
        Config.EndSound

    sound.Volume =
        5

    sound.Looped =
        false

    sound.Parent =
        endingGui

    sound:Play()

    local ended =
        false

    local connection =
        sound.Ended:Connect(function()

            ended = true

        end)

    while not ended do
        task.wait(0.05)
    end

    connection:Disconnect()

    local fadeOut =
        TweenService:Create(

            black,

            TweenInfo.new(
                Config.EndingFadeTime,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.InOut
            ),

            {
                BackgroundTransparency = 1
            }

        )

    fadeOut:Play()
    fadeOut.Completed:Wait()

    sound:Destroy()
    endingGui:Destroy()

end

return System
