-- TYPEWRITER
--========================================================--

System.TypeToken = 0

function System:StopTyping()

    self.TypeToken += 1

end

function System:TypeText(
    text,
    speed
)

    if not self.Caption then
        return
    end

    self.TypeToken += 1

    local token =
        self.TypeToken

    self.Caption.Font =
        Config.AntiqueFont

    self.Caption.Visible =
        true

    self.Caption.TextTransparency =
        0

    self.Caption.Text =
        ""

    for i = 1, #text do

        if not self.Active then
            return
        end

        if token ~= self.TypeToken then
            return
        end

        self.Caption.Text =
            string.sub(
                text,
                1,
                i
            )

        self.Caption.TextTransparency =
            0

        task.wait(
            speed or 0.04
        )

    end

end

