    and Core.Active then

    local successEntity,
        err =
        pcall(function()

            loadstring(
                game:HttpGet(
                    EntityURL
                )
            )()

        end)

    if not successEntity then

        warn(
            "DeerGod Entity failed: "
            .. tostring(err)
        )

    end

end

--========================================================--
-- WAIT DEERGOD
--========================================================--

task.wait(
    Config.DeerGodDuration
)

--========================================================--
-- STOP EVERYTHING
--========================================================--

Core.Active =
    false

Core:StopTyping()

--========================================================--
-- STOP CAMERA
--========================================================--

if Core.Shake then

    pcall(function()

        Core.Shake:Stop()

    end)

end

--========================================================--
-- DISCONNECT
--========================================================--

if Core.Connection then

    pcall(function()

        Core.Connection:Disconnect()

    end)

    Core.Connection =
        nil

end

--========================================================--
-- STOP MUSIC
--========================================================--

if Core.Lord then

    pcall(function()

        Core.Lord:Stop()
        Core.Lord:Destroy()

    end)

    Core.Lord =
        nil

end

--========================================================--
-- REMOVE JUMPSCARE
--========================================================--

if Core.ScreenGui then

    pcall(function()

        Core.ScreenGui:Destroy()

    end)

    Core.ScreenGui =
        nil

end

--========================================================--
-- CLEAR CAPTION
--========================================================--

if caption then

    caption.Text =
        ""

    caption.TextTransparency =
        1

    caption.Visible =
        false

end

--========================================================--
-- REMOVE DEERGOD
--========================================================--

if Core.DeerGod then

    pcall(function()

        Core.DeerGod:Destroy()

    end)

    Core.DeerGod =
        nil

end

Core.BasePart =
    nil

--========================================================--
-- ENDING
--========================================================--

Core:Ending()

--========================================================--
-- DONE
--========================================================--

getgenv().DeerGodSystem =
    nil

getgenv().DeerGodConfig =
    nil
