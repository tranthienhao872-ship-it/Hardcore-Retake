--========================================================--
--          DEEPNIES RANDOM OPEN DOOR SYSTEM             --
--                  DOORS / DELTA                         --
--========================================================--

getgenv().DeepniesRandomSystem =
    getgenv().DeepniesRandomSystem or {}

local System = getgenv().DeepniesRandomSystem

--========================================================--
-- ANTI DUPLICATE
--========================================================--

if System.Running then
    warn("[DEEPNIES RANDOM] Already running!")
    return
end

System.Running = true

--========================================================--
-- SETTINGS
--========================================================--

local CHANCE = 18.8

local SCRIPT_URL =
    "https://raw.githubusercontent.com/tranthienhao872-ship-it/Blaa/refs/heads/main/Deepnies"

--========================================================--
-- SERVICES
--========================================================--

local Players = game:GetService("Players")

local Player = Players.LocalPlayer

--========================================================--
-- VARIABLES
--========================================================--

local CurrentRooms
local RoomConnection

local Initialized = false
local LastRoom = nil

-- Phòng đã random
local RolledRooms = {}

--========================================================--
-- RANDOM SEED
--========================================================--

math.randomseed(
    os.time() +
    math.floor(os.clock() * 100000)
)

--========================================================--
-- CONSOLE HEADER
--========================================================--

print("")
print("==================================================")
print("          DEEPNIES RANDOM OPEN DOOR")
print("==================================================")
print("[DEEPNIES RANDOM] Chance       : 18.8%")
print("[DEEPNIES RANDOM] Initial      : OFF")
print("[DEEPNIES RANDOM] Duplicate    : OFF")
print("[DEEPNIES RANDOM] Trigger      : OPEN DOOR / NEW ROOM")
print("[DEEPNIES RANDOM] Executor     : DELTA")
print("==================================================")

--========================================================--
-- GET CURRENT ROOMS
--========================================================--

local function GetCurrentRooms()

    local Rooms =
        workspace:FindFirstChild("CurrentRooms")

    if not Rooms then
        return nil
    end

    return Rooms
end

--========================================================--
-- GET ROOM NUMBER
--========================================================--

local function GetRoomNumber(Room)

    if not Room then
        return nil
    end

    if not Room:IsA("Model") then
        return nil
    end

    return tonumber(Room.Name)
end

--========================================================--
-- GET HIGHEST ROOM
--========================================================--

local function GetHighestRoom()

    if not CurrentRooms then
        return nil
    end

    local Highest = nil

    for _, Room in ipairs(CurrentRooms:GetChildren()) do

        local Number =
            GetRoomNumber(Room)

        if Number then

            if not Highest or Number > Highest then
                Highest = Number
            end

        end

    end

    return Highest
end

--========================================================--
-- ACTIVATE DEEPNIES
--========================================================--

local function ActivateDeepnies(RoomNumber)

    if not RoomNumber then
        return
    end

    --====================================================--
    -- DUPLICATE CHECK
    --====================================================--

    if RolledRooms[RoomNumber] then

        print(
            "[DEEPNIES RANDOM] Room",
            RoomNumber,
            "already rolled -> SKIP"
        )

        return
    end

    -- Đánh dấu trước khi random
    RolledRooms[RoomNumber] = true

    --====================================================--
    -- RANDOM
    --====================================================--

    local Roll =
        math.random(1, 10000)

    local RollPercent =
        Roll / 100

    print("")
    print("--------------------------------------------------")
    print(
        "[DEEPNIES RANDOM] NEW ROOM:",
        RoomNumber
    )

    print(
        "[DEEPNIES RANDOM] Random:",
        string.format("%.2f%%", RollPercent)
    )

    print(
        "[DEEPNIES RANDOM] Required:",
        CHANCE .. "%"
    )

    --====================================================--
    -- HIT
    --====================================================--

    if Roll <= 1880 then

        print(
            "[DEEPNIES RANDOM] >>> HIT <<<"
        )

        print(
            "[DEEPNIES RANDOM] Activating Deepnies..."
        )

        task.spawn(function()

            local Success,
                ErrorMessage =
                pcall(function()

                    local Source =
                        game:HttpGet(SCRIPT_URL)

                    print(
                        "[DEEPNIES RANDOM] Script downloaded."
                    )

                    local Loader =
                        loadstring(Source)

                    if not Loader then
                        error(
                            "loadstring failed"
                        )
                    end

                    Loader()

                    print(
                        "[DEEPNIES RANDOM] Deepnies executed!"
                    )

                end)

            if not Success then

                warn(
                    "[DEEPNIES RANDOM] SCRIPT ERROR:"
                )

                warn(ErrorMessage)

            end

        end)

    --====================================================--
    -- MISS
    --====================================================--

    else

        print(
            "[DEEPNIES RANDOM] >>> MISS <<<"
        )

        print(
            "[DEEPNIES RANDOM] No Deepnies this room."
        )

        print(
            "[DEEPNIES RANDOM] Waiting for next door..."
        )

    end

    print("--------------------------------------------------")

end

--========================================================--
-- INITIALIZE
--========================================================--

task.spawn(function()

    --====================================================--
    -- WAIT FOR DOORS
    --====================================================--

    print(
        "[DEEPNIES RANDOM] Waiting for CurrentRooms..."
    )

    local Timeout = 15
    local StartTime = os.clock()

    repeat

        CurrentRooms =
            GetCurrentRooms()

        if CurrentRooms then
            break
        end

        task.wait(0.25)

    until os.clock() - StartTime >= Timeout
        or not System.Running

    if not CurrentRooms then

        warn(
            "[DEEPNIES RANDOM] ERROR: CurrentRooms not found!"
        )

        System.Running = false
        return
    end

    print(
        "[DEEPNIES RANDOM] CurrentRooms found."
    )

    --====================================================--
    -- MARK EVERY EXISTING ROOM
    --====================================================--

    local HighestRoom =
        GetHighestRoom()

    for _, Room in ipairs(CurrentRooms:GetChildren()) do

        local Number =
            GetRoomNumber(Room)

        if Number then

            RolledRooms[Number] = true

        end

    end

    LastRoom = HighestRoom

    print(
        "[DEEPNIES RANDOM] Current room:",
        tostring(HighestRoom)
    )

    print(
        "[DEEPNIES RANDOM] Existing rooms marked."
    )

    print(
        "[DEEPNIES RANDOM] Initial random: OFF"
    )

    print(
        "[DEEPNIES RANDOM] Initial Deepnies: OFF"
    )

    --====================================================--
    -- IMPORTANT INITIALIZATION DELAY
    --====================================================--

    -- Chờ replication / loading ban đầu hoàn tất
    task.wait(2)

    if not System.Running then
        return
    end

    Initialized = true

    print("")
    print("==================================================")
    print("[DEEPNIES RANDOM] SYSTEM READY")
    print("[DEEPNIES RANDOM] Waiting for OPEN DOOR...")
    print("==================================================")

    --====================================================--
    -- WATCH NEW ROOM
    --====================================================--

    RoomConnection =
        CurrentRooms.ChildAdded:Connect(function(Room)

            if not System.Running then
                return
            end

            -- Không xử lý trong initialization
            if not Initialized then
                return
            end

            local RoomNumber =
                GetRoomNumber(Room)

            if not RoomNumber then
                return
            end

            -- Phòng cũ / đã xử lý
            if RolledRooms[RoomNumber] then

                print(
                    "[DEEPNIES RANDOM] Existing room detected:",
                    RoomNumber,
                    "-> IGNORE"
                )

                return
            end

            --================================================--
            -- NEW ROOM = DOOR WAS OPENED
            --================================================--

            print("")
            print("##################################################")
            print(
                "[DEEPNIES RANDOM] NEW ROOM CREATED:",
                RoomNumber
            )
            print(
                "[DEEPNIES RANDOM] Door transition detected."
            )
            print("##################################################")

            LastRoom = RoomNumber

            -- Đợi room load một chút
            task.wait(0.15)

            -- Random đúng 1 lần
            ActivateDeepnies(RoomNumber)

        end)

end)

--========================================================--
-- STOP FUNCTION
--========================================================--

System.Stop = function()

    System.Running = false
    Initialized = false

    if RoomConnection then

        RoomConnection:Disconnect()
        RoomConnection = nil

    end

    LastRoom = nil

    table.clear(RolledRooms)

    print("")
    print("==================================================")
    print("[DEEPNIES RANDOM] SYSTEM STOPPED")
    print("==================================================")

end

