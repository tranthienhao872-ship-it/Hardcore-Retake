-- INFO
--========================================================--

print("==============================================")
print("       DEEPNIES RANDOM ROOM SYSTEM")
print("----------------------------------------------")
print(" Chance per room : 18.8%")
print(" Initial random  : OFF")
print(" Room duplicate  : OFF")
print(" Random system   : ON")
print("==============================================")
