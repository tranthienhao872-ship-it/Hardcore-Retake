print("       IS HARD RANDOM 38% - LOADED")
print("==============================================")
print("38%   : TRÚNG -> CHẠY IS HARD")
print("62%   : TRƯỢT")
print("Phòng : KHÔNG RANDOM TRÙNG")
print("Start : KHÔNG TỰ KÍCH HOẠT")
