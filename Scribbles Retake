-- SCRIPT 1: LONG TEXT EFFECT
--==================================================

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Xóa GUI cũ nếu script chạy lại
local oldGui = playerGui:FindFirstChild("LongTextGui")
if oldGui then
	oldGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LongTextGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999999
screenGui.Parent = playerGui

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 600, 0, 60)
label.Position = UDim2.new(0.5, -300, 1, -100)
label.BackgroundTransparency = 1
label.Text = "Why you in here..is so SO LONG..."
label.TextColor3 = Color3.new(1, 1, 1)
label.TextScaled = true
label.FontFace = Font.new(
	"rbxasset://fonts/families/Antique.json",
	Enum.FontWeight.Bold,
	Enum.FontStyle.Normal
)
label.TextTransparency = 1
label.Parent = screenGui

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(128, 128, 128)
stroke.Transparency = 1
stroke.Parent = label

local TweenService = game:GetService("TweenService")

local startPos = label.Position
local risePos = startPos + UDim2.new(0, 0, 0, -20)

local shaking = false

local function shakeEffect()
	local shakeAmount = 6

	while shaking and label.Parent do
		local offsetX = math.random(-shakeAmount, shakeAmount)
		local offsetY = math.random(-shakeAmount, shakeAmount)

		label.Position =
			risePos + UDim2.new(0, offsetX, 0, offsetY)

		task.wait(0.03)
	end
end

local function playEffect()
	label.Position = startPos
	label.TextTransparency = 1
	stroke.Transparency = 1

	-- FADE IN + RISE
	local fadeIn = TweenService:Create(
		label,
		TweenInfo.new(1, Enum.EasingStyle.Quad),
		{
			Position = risePos,
			TextTransparency = 0
		}
	)

	local strokeIn = TweenService:Create(
		stroke,
		TweenInfo.new(1, Enum.EasingStyle.Quad),
		{
			Transparency = 0
		}
	)

	fadeIn:Play()
	strokeIn:Play()

	-- Đợi chữ hiện hoàn toàn
	fadeIn.Completed:Wait()

	-- SHAKE
	shaking = true
	task.spawn(shakeEffect)

	task.wait(1.5)

	-- STOP SHAKE
	shaking = false
	label.Position = risePos

	-- FADE OUT
	local fadeOut = TweenService:Create(
		label,
		TweenInfo.new(1, Enum.EasingStyle.Quad),
		{
			TextTransparency = 1
		}
	)

	local strokeOut = TweenService:Create(
		stroke,
		TweenInfo.new(1, Enum.EasingStyle.Quad),
		{
			Transparency = 1
		}
	)

	fadeOut:Play()
	strokeOut:Play()

	-- QUAN TRỌNG:
	-- Đợi fade-out hoàn thành rồi mới cho Script Entity chạy
	fadeOut.Completed:Wait()
end

-- Chạy Script 1 trước
playEffect()

-- Xóa GUI sau khi Script 1 hoàn thành
if screenGui then
	screenGui:Destroy()
end


