	sound5.SoundId = "rbxassetid://0"
	sound5.Parent = workspace
	sound5:Play()

	local pitch = Instance.new("PitchShiftSoundEffect")
	pitch.Octave = 0.875
	pitch.Parent = sound5

	local introShake

	task.spawn(function()

		local CameraShaker = require(
			game.ReplicatedStorage:WaitForChild("CameraShaker")
		)

		local _CurrentCamera = workspace.CurrentCamera

		introShake = CameraShaker.new(
			Enum.RenderPriority.Camera.Value,
			function(p143)
				_CurrentCamera.CFrame =
					_CurrentCamera.CFrame * p143
			end
		)

		introShake:Start()

		introShake:Shake(
			CameraShaker.Presets.Earthquake
		)

		task.wait(5.771)

		if sound5 then
			sound5:Destroy()
		end

		task.spawn(function()

			if introShake then
				introShake:StopSustained(0.2)
			end

		end)

	end)

end)


