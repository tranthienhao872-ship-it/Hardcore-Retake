local function CreateVignette()

	local old =
		PlayerGui:FindFirstChild(VIGNETTE_GUI_NAME)

	if old then
		old:Destroy()
	end

	local gui = Instance.new("ScreenGui")

	gui.Name = VIGNETTE_GUI_NAME
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 999999
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	gui.Parent = PlayerGui

	local image = Instance.new("ImageLabel")

	image.Name = "Vignette"

	image.AnchorPoint =
		Vector2.new(0.5,0.5)

	image.Position =
		UDim2.fromScale(0.5,0.5)

	image.Size =
		UDim2.fromScale(1,1)

	image.BackgroundTransparency = 1
	image.BorderSizePixel = 0

	image.Image = VIGNETTE_IMAGE
	image.ImageColor3 =
		Color3.fromRGB(0,0,0)

	image.ImageTransparency = 1

	image.ScaleType =
		Enum.ScaleType.Stretch

	image.ZIndex = 10
	image.Parent = gui

	--================================================
	-- FADE VIGNETTE IN
	--================================================

	local fade =
		TweenService:Create(
			image,

			TweenInfo.new(
				VIGNETTE_FADE_TIME,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),

			{
				ImageTransparency = 0
			}
		)

	fade:Play()
	fade.Completed:Wait()

	if not ScriptRunning then
		gui:Destroy()
		return nil,nil,function() end
	end

	--================================================
	-- FAST BREATHING
	--================================================

	local breathing = true

	task.spawn(function()

		while breathing
			and ScriptRunning
			and gui.Parent do

			image.Size =
				UDim2.fromScale(1.08,1.08)

			task.wait(0.045)

			if not breathing
				or not ScriptRunning
				or not gui.Parent then
				break
			end

			image.Size =
				UDim2.fromScale(1,1)

			task.wait(0.045)
		end

	end)

	return gui,image,function()
		breathing = false
	end

end

