			Vector2.new(-5,3),
			Vector2.new(5,-3),

			Vector2.new(-4,-2),
			Vector2.new(4,2),

			Vector2.new(-2,1),
			Vector2.new(2,-1),

			Vector2.new(0,0)
		}

		for _,offset in ipairs(shakes) do

			if not ScriptRunning then
				return
			end

			caption.Position =
				UDim2.new(
					0.5,
					offset.X,
					0.78,
					offset.Y
				)

			task.wait(0.018)
		end

		caption.Position =
			basePosition
	end

	--================================================
	-- 10 -> 0
	--================================================

	for number = 10,0,-1 do

		if not ScriptRunning then
			break
		end

		caption.Text =
			"HIDE : "
			.. tostring(number)

		StrongShake()

		if number > 0 then
			task.wait(1)
		end

	end

	if gui and gui.Parent then
		gui:Destroy()
	end

end

--====================================================
-- START FLOW
--====================================================

-- Nhạc bắt đầu cùng effect
StartMusic()

-- Màn hình xám
screenTween:Play()

-- Đợi màn hình xám hoàn thành
screenTween.Completed:Wait()

if not ScriptRunning then
	return
end

--====================================================
-- VIGNETTE SAU KHI MÀN HÌNH XÁM XONG
--====================================================

vignetteGui,
	vignetteImage,
	stopVignette =
	CreateVignette()

if not ScriptRunning then
	return
end

--====================================================
-- TIMER 200 GIÂY
--====================================================

local effectStart =
	os.clock()

local effectEnd =
	effectStart
	+ TOTAL_DURATION

StartCameraShake(
	TOTAL_DURATION
)

--====================================================
-- ĐỢI 30 GIÂY
--====================================================

while ScriptRunning
	and os.clock() < effectEnd do

	local elapsed =
		os.clock()
		- effectStart

	if elapsed >= FIRST_HIDE_DELAY then
		break
	end

	task.wait(
		math.min(
			0.1,
			FIRST_HIDE_DELAY - elapsed
		)
	)

end

--====================================================
-- LOOP HIDE + ENTITY + GLITCH
--====================================================

while ScriptRunning
	and os.clock() < effectEnd do

	--===============================================
	-- HIDE 10 -> 0
	--===============================================

	ShowHideCountdown()

	if not ScriptRunning
		or os.clock() >= effectEnd then

		break
	end

	--===============================================
	-- HIDE = 0
	-- ENTITY
	--===============================================

	RunGlitch()

	SpawnEntity()

	--===============================================
	-- GIỮ CHU KỲ 30 GIÂY
	--===============================================

	local nextCycle =
		os.clock()
		+ HIDE_LOOP_TIME

	while ScriptRunning
		and os.clock() < nextCycle
		and os.clock() < effectEnd do

		task.wait(0.1)

	end

end

--====================================================
-- 200 GIÂY HẾT
--====================================================

ScriptRunning = false

--====================================================
-- STOP VIGNETTE BREATHING
--====================================================

if stopVignette then
	pcall(stopVignette)
end

--====================================================
-- FADE TOÀN BỘ + NHẠC
--====================================================

local fadeTweens = {}

-- GRAY SCREEN
local finalEffect =
	Lighting:FindFirstChild(
		EFFECT_NAME
	)

if finalEffect then

	table.insert(
		fadeTweens,

		TweenService:Create(
			finalEffect,

			TweenInfo.new(
				FINAL_FADE_TIME,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),

			{
				Brightness = 0,
				Contrast = 0,
				Saturation = 0
			}
		)
	)

end

-- GRAY LIGHT
if currentLight
	and currentLight.Parent then

	table.insert(
		fadeTweens,

		TweenService:Create(
			currentLight,

			TweenInfo.new(
				FINAL_FADE_TIME,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),

			{
				Brightness = 0
			}
		)
	)

end

-- VIGNETTE
if vignetteImage
	and vignetteImage.Parent then

	table.insert(
		fadeTweens,

		TweenService:Create(
			vignetteImage,

			TweenInfo.new(
				FINAL_FADE_TIME,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),

			{
				ImageTransparency = 1
			}
		)
	)

end

--====================================================
-- MUSIC FADE
--====================================================

if music
	and music.Parent then

	table.insert(
		fadeTweens,

		TweenService:Create(
			music,

			TweenInfo.new(
				FINAL_FADE_TIME,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			),

			{
				Volume = 0
			}
		)
	)

end

--====================================================
-- PLAY ALL FADE
--====================================================

for _,tween in ipairs(
	fadeTweens
) do

	tween:Play()

end

task.wait(
	FINAL_FADE_TIME
)

--====================================================
-- CLEAN EVERYTHING
--====================================================

if music
	and music.Parent then

	music:Stop()
	music:Destroy()

end

if vignetteGui
	and vignetteGui.Parent then

	vignetteGui:Destroy()

end

local finalCaption =
	PlayerGui:FindFirstChild(
		CAPTION_GUI_NAME
	)

if finalCaption then
	finalCaption:Destroy()
end

if currentLight
	and currentLight.Parent then

	currentLight:Destroy()

end

if finalEffect
	and finalEffect.Parent then

	finalEffect:Destroy()

end

--====================================================
-- END
--====================================================

ScriptRunning = false

return
