--====================================================
-- CAMERA SHAKE MỖI 2 GIÂY
--====================================================

local function StartCameraShake(duration)

	task.spawn(function()

		local success, CameraShaker =
			pcall(function()

				return require(
					game.ReplicatedStorage:
						WaitForChild("CameraShaker")
				)

			end)

		if not success or not CameraShaker then
			return
		end

		local startTime = os.clock()

		local shaker =
			CameraShaker.new(
				Enum.RenderPriority.Camera.Value,

				function(shakeCf)

					if not ScriptRunning then
						return
					end

					local camera =
						workspace.CurrentCamera

					if camera then
						camera.CFrame =
							camera.CFrame
							* shakeCf
					end

				end
			)

		shaker:Start()

		while ScriptRunning
			and os.clock() - startTime < duration do

			shaker:ShakeOnce(
				15,
				12,
				0.05,
				0.45,
				0,
				0.8
			)

			task.wait(2)
		end

		pcall(function()
			shaker:StopSustained(0.5)
		end)

	end)

end

