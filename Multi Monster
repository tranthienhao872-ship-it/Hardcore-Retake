local function ShakeSkillCheckCamera(duration: number, magnitude: number)
    task.spawn(function()
        local startTime = os.clock()
        while os.clock() - startTime < duration do
            local remaining = 1 - ((os.clock() - startTime) / duration)
            local offset = Vector3.new(
                (math.random() - 0.5) * magnitude * remaining,
                (math.random() - 0.5) * magnitude * remaining,
                0
            )
            skillCheckCamera.CFrame = skillCheckCamera.CFrame * CFrame.new(offset)
            RunService.Heartbeat:Wait()
        end
    end)
end

