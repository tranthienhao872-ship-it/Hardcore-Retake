local function ApplySkillCheckDamage(amount: number)
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 3)
    if humanoid then
        humanoid:TakeDamage(amount)
        print("[DEBUG] Đã trừ " .. tostring(amount) .. " máu (Health còn: " .. tostring(humanoid.Health) .. ")")
