local function RemoveRandomBlackSpots(count: number)
    local frames = {}
    for _, child in ipairs(BlackSpotsGui:GetChildren()) do
        if child:IsA("Frame") then
            table.insert(frames, child)
        end
    end

    for _ = 1, math.min(count, #frames) do
        local index = math.random(1, #frames)
        local spot = table.remove(frames, index)
        if spot and spot.Parent then
            TweenService:Create(spot, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {BackgroundTransparency = 1}):Play()
            task.delay(0.3, function()
                if spot and spot.Parent then
                    spot:Destroy()
                end
            end)
        end
    end
