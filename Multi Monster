-- Hàm sigmoid (S-curve) cho việc di chuyển nút TAP
local function SigmoidAlpha(t, k)
    k = k or 10
    local raw = 1 / (1 + math.exp(-k * (t - 0.5)))
    local rawStart = 1 / (1 + math.exp(-k * (0 - 0.5)))
    local rawEnd = 1 / (1 + math.exp(-k * (1 - 0.5)))
    return (raw - rawStart) / (rawEnd - rawStart)
end

local function MoveGuiSigmoid(guiObject: GuiObject, targetPosition: UDim2, duration: number)
    local startPosition = guiObject.Position
    local startTime = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not guiObject or not guiObject.Parent then
            if conn then conn:Disconnect() end
            return
        end
        local t = math.clamp((os.clock() - startTime) / duration, 0, 1)
        local alpha = SigmoidAlpha(t)
        local x = startPosition.X.Scale + (targetPosition.X.Scale - startPosition.X.Scale) * alpha
        local y = startPosition.Y.Scale + (targetPosition.Y.Scale - startPosition.Y.Scale) * alpha
        guiObject.Position = UDim2.fromScale(x, y)
        if t >= 1 then
            conn:Disconnect()
        end
    end)
end

-- Áp dụng kiểu chuyển động (easing) cho kim: None = đều, Sine = mượt vào/ra, Sigmoid = đường cong S
local function ApplyNeedleEasing(t: number, style: string)
    if style == "Sine" then
        return -(math.cos(math.pi * t) - 1) / 2
    elseif style == "Sigmoid" then
        return SigmoidAlpha(t)
    else
        return t -- "None" = tuyến tính đều
    end
end

-- Random lại kiểu chuyển động + tốc độ (có lúc nhanh có lúc chậm) cho lượt quét kế tiếp
