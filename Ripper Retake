local function BreakRoom(room)

	if not room or processedRooms[room] then
		return
	end

	processedRooms[room] = true

	task.spawn(function()

		task.wait(0.05)

		local assets = room:FindFirstChild("Assets") or room

		local mainBreak = Instance.new("Sound")
		mainBreak.SoundId = "rbxassetid://9114223171"
		mainBreak.Volume = 2.5
		mainBreak.Parent = assets
		mainBreak:Play()

		mainBreak.Ended:Connect(function()
			mainBreak:Destroy()
		end)

		local breakSounds = {
			"rbxassetid://9125992545",
			"rbxassetid://4004052860",
			"rbxassetid://7142857558",
			"rbxassetid://7142843615",
			"rbxassetid://2612674531",
			"rbxassetid://2174790942"
		}

		local blacklist = {
			"wardrobe",
			"bed",
			"rug",
			"key",
			"drawer",
			"book",
			"breaker",
			"table",
			"desk",
			"gold",
			"dresser"
		}

		for _, item in ipairs(assets:GetChildren()) do

			if item:IsA("Model")
				and item.Name ~= "Door"
				and item.Name ~= "HidingSpots" then

				local lowerName = string.lower(item.Name)
				local blocked = false

				for _, word in ipairs(blacklist) do
					if string.find(lowerName, word) then
						blocked = true
						break
					end
				end

				if not blocked then

					local primary =
						item.PrimaryPart
						or item:FindFirstChildWhichIsA("BasePart")

					if primary then

						task.spawn(function()

							for _, part in ipairs(item:GetDescendants()) do

								if part:IsA("BasePart") then

									local n =
										string.lower(part.Name)

									if not string.find(n, "floor")
										and not string.find(n, "hitbox") then

										task.wait(
											math.random(1, 4) / 100
										)

										local sound =
											Instance.new("Sound")

										sound.SoundId =
											breakSounds[
												math.random(
													1,
													#breakSounds
												)
											]

										sound.Volume =
											math.random(12, 24) / 10

										sound.PlaybackSpeed =
											math.random(85, 115) / 100

										sound.RollOffMaxDistance = 100
										sound.Parent = part
										sound:Play()

										sound.Ended:Connect(function()
											sound:Destroy()
										end)

										part.Anchored = false
										part.CanCollide = true

										part.CustomPhysicalProperties =
											PhysicalProperties.new(
												0.01,
												0.01,
												0.5,
												1,
												1
											)

										pcall(function()
											if part:CanSetNetworkOwnership() then
												part:SetNetworkOwner(
													LocalPlayer
												)
											end
										end)

										part.CFrame =
											part.CFrame +
											Vector3.new(0, 0.05, 0)
									end
								end
							end
						end)

						primary.Anchored = true
						task.wait()
						primary.Anchored = false

						primary.AssemblyLinearVelocity =
							Vector3.new(
								math.random(-60, 60),
								math.random(20, 50),
								math.random(-60, 60)
							)

						primary.AssemblyAngularVelocity =
							Vector3.new(
								math.random(-25, 25),
								math.random(-25, 25),
								math.random(-25, 25)
							)
					end
				end
			end
		end
	end)
end

