--========================================================--
-- MONOXIDE COLOR LOOP
--========================================================--

task.spawn(function()

    local Index = 1

    while ScreenGui.Parent do

        Monoxide.TextColor3 =
            MONOXIDE_COLORS[Index]

        Index += 1

        if Index >
            #MONOXIDE_COLORS then

            Index = 1

        end

        task.wait(
            COLOR_INTERVAL
        )

    end

end)

--========================================================--
-- MONOXIDE SHAKE
-- CHỈ MONOXIDE RUNG
-- KHÔNG SMOOTH
--========================================================--

task.spawn(function()

    local BasePosition =
        Monoxide.Position

    while ScreenGui.Parent do

        Monoxide.Position =
            BasePosition
            +
            UDim2.new(
                0,
                math.random(
                    -SHAKE_X,
                    SHAKE_X
                ),
                0,
                math.random(
                    -SHAKE_Y,
                    SHAKE_Y
                )
            )

        task.wait(
            SHAKE_INTERVAL
        )

        Monoxide.Position =
            BasePosition

        task.wait(
            SHAKE_INTERVAL
        )

    end

end)

