--========================================================--
-- ON SPAWNED
--========================================================--

entity:SetCallback(
    "OnSpawned",
    function()

        local sound5 =
            Instance.new("Sound")

        sound5.PlaybackSpeed =
            0.6

        sound5.Volume =
            10

        sound5.Parent =
            workspace

        sound5:Play()

        local pitch =
            Instance.new(
                "PitchShiftSoundEffect"
            )

        pitch.Octave =
            0.875

        pitch.Parent =
            sound5

        local introShake

        task.spawn(function()

            local CameraShaker =
                require(
                    game.ReplicatedStorage:
                    WaitForChild(
                        "CameraShaker"
                    )
                )

            local CurrentCamera =
                workspace.CurrentCamera

            introShake =
                CameraShaker.new(
                    Enum.RenderPriority.Camera.Value,
                    function(CFrameOffset)

                        CurrentCamera.CFrame =
                            CurrentCamera.CFrame
                            * CFrameOffset

                    end
                )

            introShake:Start()

            introShake:Shake(
                CameraShaker.Presets.Earthquake
            )

            task.wait(
                5.771
            )

            if sound5 then
                sound5:Destroy()
            end

            if introShake then

                task.spawn(function()

                    introShake:StopSustained(
                        0.2
                    )

                end)

            end

        end)

    end
)

