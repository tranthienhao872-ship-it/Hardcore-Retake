--                    LOAD SYSTEM                       --
--========================================================--

for i, Script in ipairs(Scripts) do
    task.spawn(function()
        local success, result = pcall(function()
            local Source = game:HttpGet(Script.URL)
            local Function = loadstring(Source)

            if not Function then
                error("loadstring failed")
            end

            return Function()
        end)

        if success then
            print("[Retake Hub] ✓ " .. i .. "/9 Loaded: " .. Script.Name)
        else
            warn("[Retake Hub] ✗ " .. i .. "/9 Failed: " .. Script.Name)
            warn(tostring(result))
        end
    end)

    task.wait(0.15)
end

