local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local EXHAUSTED_SOUND_ID = "rbxassetid://8258601891"

local LocalPlayer = Players.LocalPlayer

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

LocalPlayer.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = newChar:WaitForChild("Humanoid")
end)

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SprintGui"
screenGui.IgnoreGuiInset = true
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local exhaustedSound = Instance.new("Sound")
exhaustedSound.Name = "ExhaustedSound"
exhaustedSound.SoundId = EXHAUSTED_SOUND_ID
exhaustedSound.Volume = 4
exhaustedSound.Parent = screenGui

local sprintBarBackground = Instance.new("Frame")
sprintBarBackground.Size = UDim2.new(0.212, 0, 0.041, 0)
sprintBarBackground.Position = UDim2.new(0.787, 0, 0.484, 0)
sprintBarBackground.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
sprintBarBackground.BorderSizePixel = 3
sprintBarBackground.Parent = screenGui

local uicorner = Instance.new("UICorner")
uicorner.CornerRadius = UDim.new(0, 8)
uicorner.Parent = sprintBarBackground

local sprintBar = Instance.new("Frame")
sprintBar.Size = UDim2.new(1, 0, 1, 0)
sprintBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
sprintBar.BorderSizePixel = 0
sprintBar.Parent = sprintBarBackground

local uicorner5 = Instance.new("UICorner")
uicorner5.CornerRadius = UDim.new(0, 8)
uicorner5.Parent = sprintBar

local darkScreen = Instance.new("Frame")
darkScreen.Size = UDim2.new(1, 0, 1, 0)
darkScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
darkScreen.BackgroundTransparency = 1
darkScreen.Parent = screenGui

local sprinting = false
local maxStamina = 100
local currentStamina = maxStamina
local staminaRegenRate = 15
local staminaDrainRate = 13
local canSprint = true
local isExhausted = false

local regenDelayTimer = 0
local REGEN_DELAY_TIME = 4

local sprintSpeed = 20
local walkSpeed = 15
local exhaustedSpeed = 10

local function updateSprintBar()
	sprintBar.Size = UDim2.new(currentStamina / maxStamina, 0, 1, 0)
end

local function updateDarkScreen()
	if currentStamina < 100 then
		local percent = math.clamp(1 - (currentStamina / 70), 0, 1)
		darkScreen.BackgroundTransparency = 1 - (percent * 0.4)
	else
		darkScreen.BackgroundTransparency = 1
	end
end

local function setSprinting(enabled)
	if isExhausted then return end

	if enabled and canSprint and currentStamina > 0 then
		sprinting = true
		if humanoid then humanoid.WalkSpeed = sprintSpeed end
		if character then character:SetAttribute("SpeedBoost", sprintSpeed - walkSpeed) end
	else
		sprinting = false
		if humanoid then humanoid.WalkSpeed = walkSpeed end
		if character then character:SetAttribute("SpeedBoost", 0) end
	end
end

if UserInputService.TouchEnabled then
	local sprintButton = Instance.new("ImageButton")
	sprintButton.Size = UDim2.new(0.083, 0, 0.115, 0)
	sprintButton.Position = UDim2.new(0.916, 0, 0.369, 0)
	sprintButton.Image = "rbxassetid://111292680671790"
	sprintButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
	sprintButton.BackgroundTransparency = 1
	sprintButton.ImageTransparency = 0.4
	sprintButton.Parent = screenGui

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 8)
	buttonCorner.Parent = sprintButton

	sprintButton.MouseButton1Click:Connect(function()
		setSprinting(not sprinting)
	end)
else
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.Q then
			setSprinting(true)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.Q then
			setSprinting(false)
		end
	end)
end

RunService.Heartbeat:Connect(function(dt)
	if sprinting then
		if currentStamina > 0 then
			currentStamina -= staminaDrainRate * dt
		else
			sprinting = false
			canSprint = false

			if not isExhausted then
				isExhausted = true
				regenDelayTimer = REGEN_DELAY_TIME

				if character then
					character:SetAttribute("SpeedBoost", -5)
				end
				if humanoid then
					humanoid.WalkSpeed = exhaustedSpeed
				end

				-- PhĂ¡t Ă¢m thanh kiá»‡t sá»©c
				if exhaustedSound.SoundId ~= "rbxassetid://0" then
					exhaustedSound:Play()
				end

				task.spawn(function()
					pcall(function()
						local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainUI")
						if mainUI and mainUI:FindFirstChild("Initiator") and mainUI.Initiator:FindFirstChild("Main_Game") then
							require(mainUI.Initiator.Main_Game).caption("You're exhausted", true)
						end
					end)
				end)
			end
		end
	else
		if regenDelayTimer > 0 then
			regenDelayTimer -= dt
		elseif currentStamina < maxStamina then
			currentStamina += staminaRegenRate * dt
		end
	end

	if currentStamina >= maxStamina and isExhausted then
		isExhausted = false
		canSprint = true

		if exhaustedSound.IsPlaying then
			exhaustedSound:Stop()
		end

		if character then
			character:SetAttribute("SpeedBoost", 0)
		end
		if humanoid then
			humanoid.WalkSpeed = walkSpeed
		end
	end

	currentStamina = math.clamp(currentStamina, 0, maxStamina)

	updateSprintBar()
	updateDarkScreen()
end)
