local endingStarted = false
local endingFinished = false

--========================================================--
--                ENDING SEQUENCE                      --
--========================================================--

local function StartEndingSequence(
	currentEntity
)

	if endingStarted then
		return
	end

	endingStarted = true

	coldLockedDown = true

	--====================================================--
	--       FADE PARTICLE KHI FROSTBITE MẤT           --
	--====================================================--

	if currentEntity
		and currentEntity.Parent then

		task.spawn(function()

			FadeFrostbiteParticles(
				currentEntity,
				PARTICLE_FADE_TIME
			)

		end)
	end

	--====================================================--
	--              MAIN SOUND FADE                      --
	--====================================================--

	if mainSound
		and mainSound.Parent then

		TweenService:Create(
			mainSound,
			TweenInfo.new(
				END_FADE_TIME,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Volume = 0
			}
		):Play()
	end

	--====================================================--
	--               DARK BLUE EFFECT                   --
	--====================================================--

	local darkEffect =
		Instance.new(
			"ColorCorrectionEffect"
		)

	darkEffect.Name =
		"FrostbiteDarkFade"

	darkEffect.TintColor =
		Color3.fromRGB(
			0,
			20,
			80
		)

	darkEffect.Saturation = -0.85
	darkEffect.Contrast = 0.4
	darkEffect.Brightness = -0.15

	darkEffect.Parent =
		Lighting

	--====================================================--
	--                  END SOUND                       --
	--====================================================--

	local endingSound =
		Instance.new(
			"Sound"
		)

	endingSound.Name =
		"FrostbiteEndingSound"

	endingSound.SoundId =
		END_SOUND_ID

	endingSound.Volume = 2
	endingSound.Looped = false
	endingSound.Parent =
		workspace

	endingSound:Play()

	--====================================================--
	--                ENDING SHAKE                     --
	--====================================================--

	cameraShakeAmplitude =
		endingShakePower

	local fadeStarted = false

	while endingSound.Parent do

		if not endingSound.IsPlaying then
			break
		end

		if endingSound.TimeLength > 0 then

			local remaining =
				endingSound.TimeLength
				- endingSound.TimePosition

			if remaining
				<= END_FADE_TIME
				and not fadeStarted then

				fadeStarted = true

				--========================================--
				--         END SOUND FADE               --
				--========================================--

				TweenService:Create(
					endingSound,
					TweenInfo.new(
						math.max(
							remaining,
							0.1
						),
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),
					{
						Volume = 0
					}
				):Play()

				--========================================--
				--             SHAKE FADE               --
				--========================================--

				task.spawn(function()

					local startPower =
						endingShakePower

					local start =
						tick()

					local duration =
						math.max(
							remaining,
							0.1
						)

					while tick() - start
						< duration do

						local alpha =
							math.clamp(
								(
									tick()
									- start
								)
								/ duration,
								0,
								1
							)

						local smooth =
							alpha
							* alpha
							* (
								3
								- 2 * alpha
							)

						cameraShakeAmplitude =
							startPower
							* (
								1 - smooth
							)

						task.wait()
					end

					cameraShakeAmplitude = 0
				end)

				--========================================--
				--          BLUE SCREEN FADE             --
				--========================================--

				if frost
					and frost.Parent then

					TweenService:Create(
						frost,
						TweenInfo.new(
							math.max(
								remaining,
								0.1
							),
							Enum.EasingStyle.Quad,
							Enum.EasingDirection.Out
						),
						{
							TintColor =
								Color3.fromRGB(
									255,
									255,
									255
								),

							Saturation = 0,
							Contrast = 0,
							Brightness = 0
						}
					):Play()
				end

				--========================================--
				--          DARK SCREEN FADE             --
				--========================================--

				TweenService:Create(
					darkEffect,
					TweenInfo.new(
						math.max(
							remaining,
							0.1
						),
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),
					{
						TintColor =
							Color3.fromRGB(
								255,
								255,
								255
							),

						Saturation = 0,
						Contrast = 0,
						Brightness = 0
					}
				):Play()

				--========================================--
				--               BAR OUT                 --
				--========================================--

				if container
					and container.Parent then

					TweenService:Create(
						container,
						TweenInfo.new(
							math.max(
								remaining,
								0.1
							),
							Enum.EasingStyle.Quint,
							Enum.EasingDirection.In
						),
						{
							Position =
								UDim2.new(
									1,
									20,
									1,
									-40
								)
						}
					):Play()
				end
			end
		end

		task.wait(0.03)
	end

	--====================================================--
	--          PARTICLE FINAL FADE / DESTROY          --
	--====================================================--

	if currentEntity
		and currentEntity.Parent then

		FadeFrostbiteParticles(
			currentEntity,
			PARTICLE_FADE_TIME
		)

		if currentEntity
			and currentEntity.Parent then

			currentEntity:Destroy()
		end
	end

	--====================================================--
	--                 FINAL FADE                       --
	--====================================================--

	cameraShakeAmplitude = 0

	if frost
		and frost.Parent then

		TweenService:Create(
			frost,
			TweenInfo.new(
				0.5,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				TintColor =
					Color3.fromRGB(
						255,
						255,
						255
					),

				Saturation = 0,
				Contrast = 0,
				Brightness = 0
			}
		):Play()
	end

	TweenService:Create(
		darkEffect,
		TweenInfo.new(
			0.5,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			TintColor =
				Color3.fromRGB(
					255,
					255,
					255
				),

			Saturation = 0,
			Contrast = 0,
			Brightness = 0
		}
	):Play()

	task.wait(0.6)

	StopCustomShake()

	if endingSound
		and endingSound.Parent then

		endingSound.Volume = 0
		endingSound:Stop()
		endingSound:Destroy()
	end

	if mainSound
		and mainSound.Parent then

		mainSound.Volume = 0
		mainSound:Stop()
		mainSound:Destroy()
	end

	if darkEffect
		and darkEffect.Parent then

		darkEffect:Destroy()
	end

	if frost
		and frost.Parent then

		frost:Destroy()
	end

	if container
		and container.Parent then

		container:Destroy()
	end

	endingFinished = true
end

