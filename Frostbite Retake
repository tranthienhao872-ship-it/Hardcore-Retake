local function GetGithubModel(url)

	local fileName =
		string.match(
			url,
			"([^/]+)$"
		)
		or "temp_model.rbxm"

	if not isfile(fileName) then

		local response =
			http_request({
				Url = url,
				Method = "GET"
			})

		if not response
			or response.StatusCode ~= 200 then

			return nil
		end

		writefile(
			fileName,
			response.Body
		)
	end

	local assetId =
		getasset(fileName)

	local success, result =
		pcall(
			function()

				return game:GetObjects(
					assetId
				)[1]

			end
		)

	if success then
		return result
	end

	return nil
end

