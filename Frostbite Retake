				)

			local fireEffect =
				Instance.new(
					"Fire"
				)

			if neonPart then

				neonPart.Transparency = 1

				fireEffect.Parent =
					neonPart

			else

				fireEffect.Parent =
					activeHeatFixture
			end

			local pointLight =
				activeHeatFixture:FindFirstChildWhichIsA(
					"PointLight",
					true
				)

			if not pointLight then

				pointLight =
					Instance.new(
						"PointLight"
					)

				pointLight.Parent =
					neonPart
					or activeHeatFixture
			end

			pointLight.Range = 12
			pointLight.Brightness = 3
			pointLight.Enabled = true

			task.delay(
				15,
				function()

					if fireEffect
						and fireEffect.Parent then

						fireEffect:Destroy()
					end

					if pointLight
						and pointLight.Parent then

						pointLight.Enabled = false
					end

					activeHeatFixture = nil
				end
			)
		end
	end

	--====================================================--
	--                    ENTITY                       --
	--====================================================--

	local entityModel =
		modelTemplate:Clone()

	entityModel.Name =
		"Frostyma5n"

	entityModel.Parent =
		workspace

	currentEntity =
		entityModel

	local entity =
		entityModel:FindFirstChildWhichIsA(
			"BasePart"
		)
		or entityModel.PrimaryPart
		or entityModel:FindFirstChild(
			"FrostyNew"
		)

	if not entity then

		entityModel:Destroy()
		break
	end

	entity.CanCollide = false

	local entrance =
		currentRoom:FindFirstChild(
			"RoomEntrance"
		)

	if entrance then

		local rooms =
			workspace.CurrentRooms

		local children =
			rooms:GetChildren()

		local lastRoom =
			children[
				#children - 1
			]

		if lastRoom
			and lastRoom:FindFirstChild(
				"Parts"
			)
			and lastRoom.Parts:FindFirstChild(
				"Floor"
			) then

			entity.CFrame =
				lastRoom.Parts.Floor.CFrame
				+ Vector3.new(
					0,
					6,
					0
				)
		end
	end

	task.wait(0.5)

	camera =
		workspace.CurrentCamera

	cameraShakeAmplitude =
		normalShake

	local attacking = true

	--====================================================--
	--                 ROOM CHANGE                      --
	--====================================================--

	local roomConnection

	roomConnection =
		workspace.CurrentRooms.ChildAdded:Connect(
			function(newRoom)

				if not attacking then
					return
				end

				task.wait(1)

				local actualNew =
					workspace.CurrentRooms[
						ReplicatedStorage
							.GameData
							.LatestRoom.Value
					]

				--================================================--
				--       BAR HẾT -> PHÒNG MỚI ĐỔI ROCK       --
				--================================================--

				if coldDepleted
					and actualNew then

					TurnRoomIntoRock(
						actualNew
					)

					rockTriggeredForRoom[
						tostring(
							ReplicatedStorage
								.GameData
								.LatestRoom
								.Value
						)
					] = true
				end

				local nextEntrance =
					actualNew
					and actualNew:FindFirstChild(
						"RoomEntrance"
					)

				if nextEntrance
					and entity
					and entity.Parent then

					local rooms =
						workspace.CurrentRooms

					local children =
						rooms:GetChildren()

					local lastRoom =
						children[
							#children - 1
						]

					if lastRoom
						and lastRoom:FindFirstChild(
							"Parts"
						)
						and lastRoom.Parts:FindFirstChild(
							"Floor"
						) then

						local targetCFrame =
							lastRoom.Parts.Floor.CFrame
							+ Vector3.new(
								0,
								6,
								0
							)

						local moveTween =
							TweenService:Create(
								entity,
								TweenInfo.new(
									0.5,
									Enum.EasingStyle.Quad,
									Enum.EasingDirection.InOut
								),
								{
									CFrame =
										targetCFrame
								}
							)

						moveTween:Play()
						moveTween.Completed:Wait()
					end
				end

				attacking = false

				if roomConnection then
					roomConnection:Disconnect()
				end
				--================================================--
				--       FROSTBITE PARTICLE FADE               --
				--================================================--

				if entityModel
					and entityModel.Parent then

					task.spawn(function()

						FadeFrostbiteParticles(
							entityModel,
							PARTICLE_FADE_TIME
						)

						if entityModel
							and entityModel.Parent then

							entityModel:Destroy()
						end

					end)
				end

				currentEntity = nil
			end
		)

	--====================================================--
	--                  SCREEN EFFECT                  --
	--====================================================--

	task.spawn(function()

		local screenGui =
			Instance.new(
				"ScreenGui"
			)

		screenGui.Name =
			"Aihoi"

		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 999999
		screenGui.Parent =
			playerGui

		local imageLabel =
			Instance.new(
				"ImageLabel"
			)

		imageLabel.BackgroundTransparency = 1
		imageLabel.BorderSizePixel = 0

		imageLabel.Position =
			UDim2.new(
				0,
				0,
				0,
				0
			)

		imageLabel.Size =
			UDim2.new(
				1,
				0,
				1,
				0
			)

		imageLabel.ScaleType =
			Enum.ScaleType.Stretch

		imageLabel.Image =
			"rbxassetid://16967638719"

		imageLabel.ImageTransparency = 0
		imageLabel.Parent =
			screenGui

		local blur =
			Lighting:FindFirstChild(
				"Blur5"
			)

		if not blur then

			blur =
				Instance.new(
					"BlurEffect"
				)

			blur.Name =
				"Blur5"

			blur.Size = 10
			blur.Parent =
				Lighting

		else

			blur.Enabled = true
		end

		--================================================--
		--                  COLD LOOP                    --
		--================================================--

		while attacking
			and entity
			and entity.Parent
			and not endingStarted do

			task.wait(0.1)

			local character =
				player.Character

			if not character then
				continue
			end

			local humanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			if not humanoid
				or humanoid.Health <= 0 then

				break
			end

			--================================================--
			--       BAR ĐÃ HẾT -> KHÓA 0 VĨNH VIỄN       --
			--================================================--

			if coldDepleted then

				currentCold = 0
				lowestCold = 0

				fillBar.Size =
					UDim2.new(
						0,
						0,
						1,
						0
					)

				imageLabel.ImageTransparency = 0

				if blur then
					blur.Enabled = true
				end

				humanoid.Health =
					math.max(
						0,
						humanoid.Health
							- DAMAGE_AMOUNT
					)

				-- Phòng hiện tại luôn bị đổi.
				TurnRoomIntoRock(
					currentRoom
				)

				continue
			end

			--================================================--
			--              CHỈ ĐƯỢC GIẢM                --
			--================================================--

			local drainAmount = 0.4

			local lighter =
				character:FindFirstChild(
					"Lighter"
				)

			local lighterOn =
				lighter
				and lighter:GetAttribute(
					"Enabled"
				)

			-- Lighter chỉ làm chậm tụt.
			-- KHÔNG BAO GIỜ hồi bar.
			if lighterOn then
				drainAmount = 0.1
			end

			DrainCold(
				drainAmount
			)

			--================================================--
			--                UPDATE BAR                  --
			--================================================--

			if coldDepleted then

				currentCold = 0
				lowestCold = 0

				fillBar.Size =
					UDim2.new(
						0,
						0,
						1,
						0
					)

				imageLabel.ImageTransparency = 0

				if blur then
					blur.Enabled = true
				end

				-- Bar hết -> đổi phòng hiện tại.
				TurnRoomIntoRock(
					currentRoom
				)

				humanoid.Health =
					math.max(
						0,
						humanoid.Health
							- DAMAGE_AMOUNT
					)

			else

				-- Chống mọi trường hợp bar tăng.
				if currentCold > lowestCold then

					currentCold =
						lowestCold
				end

				local percent =
					math.clamp(
						currentCold
							/ MAX_COLD,
						0,
						1
					)

				fillBar.Size =
					UDim2.new(
						percent,
						0,
						1,
						0
					)

				imageLabel.ImageTransparency =
					percent

				if currentCold < 30 then

					if blur then
						blur.Enabled = true
					end

				else

					if blur then
						blur.Enabled = false
					end
				end
			end

			--================================================--
			--              ROCK AT 92%                   --
			--================================================--

			if not coldDepleted
				and currentCold <= ROCK_TRIGGER
				and not rockTriggeredForRoom[
					roomNumber
				] then

				rockTriggeredForRoom[
					roomNumber
				] = true

				TurnRoomIntoRock(
					currentRoom
				)
			end
		end

		if blur
			and blur.Parent then

			blur.Enabled = false
		end

		if screenGui
			and screenGui.Parent then

			screenGui:Destroy()
		end
	end)

	repeat
		task.wait(0.1)
	until not attacking
		or endingStarted
end

--========================================================--
--                 FROSTBITE END                       --
--========================================================--

StartEndingSequence(
	currentEntity
)

while not endingFinished do
	task.wait(0.1)
end

--========================================================--
--                 FINAL CLEANUP                       --
--========================================================--

StopCustomShake()

local blurObj =
	Lighting:FindFirstChild(
		"Blur5"
	)

if blurObj then
	blurObj:Destroy()
end

local darkObj =
	Lighting:FindFirstChild(
		"FrostbiteDarkFade"
	)

if darkObj then
	darkObj:Destroy()
end

if mainSound
	and mainSound.Parent then

	mainSound.Volume = 0
	mainSound:Stop()
	mainSound:Destroy()
end

if frost
	and frost.Parent then

	frost:Destroy()
end

if gui
	and gui.Parent then

	gui:Destroy()
end
