local lowestCold = MAX_COLD

--========================================================--
--                  ROCK ROOM SYSTEM                    --
--========================================================--

local rockTriggeredForRoom = {}

local function TurnRoomIntoRock(room)

	if not room
		or not room.Parent then

		return
	end

	for _, obj in ipairs(
		room:GetDescendants()
	) do

		if obj:IsA("BasePart") then

			pcall(function()

				obj.Material =
					Enum.Material.Rock

				obj.Color =
					ROCK_COLOR

			end)
		end
	end
end

--========================================================--
--        APPLY ROCK WHEN BAR IS ALREADY EMPTY          --
--========================================================--

local function CheckDepletedRoom(room)

	if not coldDepleted then
		return
	end

	if not room
		or not room.Parent then

		return
	end

	TurnRoomIntoRock(room)
end

--========================================================--
--                 BAR LOCK SYSTEM                      --
--========================================================--

local function SetCold(newValue)

	-- Bar đã hết thì khóa 0 vĩnh viễn.
	if coldDepleted then

		currentCold = 0
		lowestCold = 0

		return
	end

	newValue =
		math.clamp(
			tonumber(newValue)
				or currentCold,
			0,
			MAX_COLD
		)

	-- Không bao giờ được tăng.
	if newValue > lowestCold then
		newValue = lowestCold
	end

	if newValue < lowestCold then
		lowestCold = newValue
	end

	currentCold = newValue

	--====================================================--
	--              BAR HẾT = LOCK 0                   --
	--====================================================--

	if currentCold <= 0 then

		currentCold = 0
		lowestCold = 0

		coldDepleted = true
		coldLockedDown = true

		-- Phòng hiện tại đổi ngay.
		local rooms =
			workspace:FindFirstChild(
				"CurrentRooms"
			)

		if rooms
			and latestRoom.Value then

			local room =
				rooms:FindFirstChild(
					tostring(
						latestRoom.Value
					)
				)

			if room then

				TurnRoomIntoRock(
					room
				)
			end
		end
	end
end

local function DrainCold(amount)

	if coldDepleted then

		currentCold = 0

		return
	end

	amount =
		math.max(
			0,
			tonumber(amount) or 0
		)

	SetCold(
		currentCold - amount
	)
end

--========================================================--
--              FROSTBITE PARTICLE FADE                --
--========================================================--

local function FadeFrostbiteParticles(
	model,
	fadeTime
)

	if not model
		or not model.Parent then

		return
	end

	fadeTime =
		fadeTime
		or PARTICLE_FADE_TIME

	local particles = {}

	-- Tìm tất cả ParticleEmitter
	for _, obj in ipairs(
		model:GetDescendants()
	) do

		if obj:IsA("ParticleEmitter") then

			table.insert(
				particles,
				obj
			)

			-- Fade từ transparency hiện tại
			-- sang hoàn toàn trong suốt.
			pcall(function()

				TweenService:Create(
					obj,
					TweenInfo.new(
						fadeTime,
						Enum.EasingStyle.Quad,
						Enum.EasingDirection.Out
					),
					{
						Transparency =
							NumberSequence.new(
								1
							)
					}
				):Play()

			end)

			-- Ngừng phát particle mới.
			pcall(function()

				obj.Enabled = false

			end)
		end
	end

	-- Chờ particle fade.
	task.wait(
		fadeTime
	)

	-- Đảm bảo particle biến mất hoàn toàn.
	for _, particle in ipairs(
		particles
	) do

		if particle
			and particle.Parent then

			pcall(function()

				particle.Enabled = false

			end)

			pcall(function()

				particle.Transparency =
					NumberSequence.new(
						1
					)

			end)
		end
	end
end

