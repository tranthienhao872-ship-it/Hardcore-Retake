--                  CAMERA SHAKE                        --
--========================================================--

local camera =
	workspace.CurrentCamera

local cameraShakeConnection = nil

local cameraShakeAmplitude = 0

local normalShake = 1.25

local endingShakePower = 7.5

local function StartCustomShake()

	if cameraShakeConnection then
		return
	end

	cameraShakeConnection =
		RunService.RenderStepped:Connect(
			function()

				if not camera then

					camera =
						workspace.CurrentCamera
				end

				if not camera then
					return
				end

				if cameraShakeAmplitude
					<= 0.001 then

					return
				end

				local x =
					(math.random() - 0.5)
					* 2

				local y =
					(math.random() - 0.5)
					* 2

				local z =
					(math.random() - 0.5)
					* 2

				local rotationX =
					math.rad(
						(math.random() - 0.5)
						* 2
					)
					* cameraShakeAmplitude
					* 0.35

				local rotationY =
					math.rad(
						(math.random() - 0.5)
						* 2
					)
					* cameraShakeAmplitude
					* 0.35

				local rotationZ =
					math.rad(
						(math.random() - 0.5)
						* 2
					)
					* cameraShakeAmplitude
					* 0.2

				local offset =
					Vector3.new(
						x,
						y,
						z
					)
					* cameraShakeAmplitude
					* 0.08

				camera.CFrame =
					camera.CFrame
					* CFrame.new(
						offset
					)
					* CFrame.Angles(
						rotationX,
						rotationY,
						rotationZ
					)
			end
		)
end

local function StopCustomShake()

	if cameraShakeConnection then

		cameraShakeConnection:Disconnect()

		cameraShakeConnection = nil
	end

	cameraShakeAmplitude = 0
end

StartCustomShake()

